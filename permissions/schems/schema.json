{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Plugin Permissions",
  "description": "Permissions for the review plugin",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "enum": [
        "allow-request-review"
      ]
    }
  },
  "default": {
    "identifier": "allow-request-review",
    "allow": [
      {
        "command": "request_review"
      }
    ]
  }
}